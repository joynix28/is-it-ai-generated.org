/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' blob: data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self' blob:; upgrade-insecure-requests

# The HTML and every module it loads must revalidate together. Caching them for
# an hour shipped an old module against a new document and broke the boot.
# ETags make revalidation cheap.
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/app/*
  Cache-Control: no-cache

/styles.css
  Cache-Control: no-cache

/i18n/*
  Cache-Control: no-cache

/api/*
  Access-Control-Allow-Origin: *
  Cache-Control: no-store
  X-Content-Type-Options: nosniff

# Content-addressed and version-pinned: safe to cache forever.
/models/*
  Cache-Control: public, max-age=31536000, immutable

/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=604800
