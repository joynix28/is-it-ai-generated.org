/*
  Cross-Origin-Opener-Policy + Cross-Origin-Embedder-Policy unlock
  SharedArrayBuffer, which lets Transformers.js run its WebAssembly on multiple
  threads and keeps the main thread at 60fps.

  COEP: require-corp means every cross-origin subresource must opt in. The model
  is fetched with CORS from the Hugging Face CDN (which sends
  Access-Control-Allow-Origin: *), so the fetch is allowed. Nothing else leaves
  this origin.

  Cache: the app shell revalidates together (no-cache + ETag); hashed assets and
  the model are immutable.
*/
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; script-src 'self' 'wasm-unsafe-eval' blob:; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://huggingface.co https://*.hf.co https://cdn.jsdelivr.net; worker-src 'self' blob:; manifest-src 'self'

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/404.html
  Cache-Control: no-cache

/404.css
  Cache-Control: public, max-age=3600
