{
  "name": "is-it-ai-generated",
  "version": "0.3.0",
  "description": "Privacy-first, fully client-side AI text & image detector, word counter and language toolkit. No ads, no tracking, no data leaves the browser.",
  "type": "module",
  "license": "MIT",
  "author": "Joynix <joynix@chell.fr>",
  "homepage": "https://is-it-ai-generated.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joynix28/is-it-ai-generated.org.git"
  },
  "bugs": {
    "url": "https://github.com/joynix28/is-it-ai-generated.org/issues"
  },
  "keywords": [
    "ai-detection",
    "ai-generated",
    "detector",
    "text-analysis",
    "image-forensics",
    "word-counter",
    "language-detection",
    "privacy",
    "client-side",
    "cloudflare-pages"
  ],
  "main": "./src/core/index.js",
  "types": "./src/core/index.d.ts",
  "exports": {
    ".": "./src/core/index.js",
    "./core": "./src/core/index.js",
    "./text": "./src/core/textDetector.js",
    "./image": "./src/core/imageDetector.js",
    "./lang": "./src/core/langdetect.js",
    "./counter": "./src/core/wordCounter.js",
    "./unicode": "./src/core/unicode.js",
    "./c2pa": "./src/core/c2pa.js",
    "./watermark": "./src/core/watermark.js",
    "./cbor": "./src/core/cbor.js",
    "./hash": "./src/core/hash.js"
  },
  "bin": {
    "isitai": "./bin/isitai.mjs"
  },
  "files": [
    "src/core",
    "bin",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "fetch:assets": "node scripts/fetch-assets.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "deploy": "npm run build && wrangler pages deploy public --project-name=is-it-ai-generated",
    "stats:create": "node scripts/create-stats-store.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false
}
